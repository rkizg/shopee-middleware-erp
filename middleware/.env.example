# ==========================================
# SHOPEE OPEN API CONFIGURATION
# ==========================================
# Dapatkan Partner ID dan Partner Key dari Shopee Open Platform (https://open.shopee.com)
# Satu app (satu partner_id dan partner_key) dapat dipakai beberapa toko Shopee.
# Lihat docs/arsitektur-multi-toko.md untuk rencana pengelolaan banyak toko.
SHOPEE_PARTNER_ID=1234567
SHOPEE_PARTNER_KEY=your_shopee_partner_key_here
# Hanya dipakai sebagai nilai bawaan saat toko tidak ditentukan pada permintaan.
# Token dan shop_id setiap toko dikirim oleh Apps Script, bukan dibaca dari sini.
SHOPEE_SHOP_ID=987654321
# Region: GLOBAL (Default untuk Shopee Indonesia - partner.shopeemobile.com) atau TEST_GLOBAL (Sandbox)
SHOPEE_REGION=GLOBAL

# URL Callback OAuth2 Shopee (Arahkan ke domain Vercel Anda)
# Contoh: https://erp-begood.vercel.app/api/auth/callback
SHOPEE_REDIRECT_URI=https://your-middleware.vercel.app/api/auth/callback

# ==========================================
# KEAMANAN MIDDLEWARE BEGOOD
# ==========================================
# Kunci rahasia untuk mengamankan API middleware agar hanya bisa diakses oleh Google Apps Script Begood
BEGOOD_API_SECRET=your_super_secret_begood_token_2026
